# NexusBrain Environment Configuration
# Dual-Mode FalkorDB Connection Settings
# 1. Local Docker (Default - Zero Credentials)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# 2. FalkorDB Cloud (Optional)
# FALKORDB_HOST=xyz.cloud.falkordb.com
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your_secret_password

# Multigraph Names
COMPANY_GRAPH_NAME=company_brain
TENANT_GRAPH_PREFIX=memory_tenant_

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Storage Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
